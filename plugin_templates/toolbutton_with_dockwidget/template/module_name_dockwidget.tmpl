import os

from qgis.PyQt import QtWidgets, uic
from qgis.PyQt.QtCore import pyqtSignal, QDir, QEvent, QTimer, QUrl
from qgis.PyQt.QtGui import QDesktopServices

from . import PLUGIN_VERSION, QSS_IMAGES_PREFIX
from .constants import FOOTER_LINK_COLORS, FOOTER_LOGOS, FOOTER_LOGO_HEIGHT, HOME_LINK
from .utils import MessageUtils, TranslationUtils, ThemeUtils

PLUGIN_DIR = os.path.dirname(__file__)

# Musi być zarejestrowany przed setupUi, inaczej QSS nie znajdzie ikon.
QDir.addSearchPath(QSS_IMAGES_PREFIX, os.path.join(PLUGIN_DIR, 'images'))

FORM_CLASS, _ = uic.loadUiType(os.path.join(PLUGIN_DIR, 'ui', '${TemplateModuleName}_dockwidget_base.ui'))


class ${TemplateClass}DockWidget(QtWidgets.QDockWidget, FORM_CLASS):

    closingPlugin = pyqtSignal()

    def __init__(self, parent=None):
        super(${TemplateClass}DockWidget, self).__init__(parent)
        self.setupUi(self)
        # QGIS zapamiętuje położenie panelu po nazwie obiektu.
        self.setObjectName('${TemplateClass}Dock')
        self._theme = None
        self._heightFitted = False
        self._applyTheme()
        self._setupLook()
        self._setupSignals()

    def _setupLook(self):
        self.lbl_pluginVersion.setText('v%s' % PLUGIN_VERSION)
        self.btn_help.clicked.connect(self._openHelp)
        self.btn_close.clicked.connect(self.close)
        self.verticalLayout_main.removeWidget(self.header_frame)
        self.setTitleBarWidget(self.header_frame)

    def _applyTheme(self, force=False):
        theme = 'dark' if ThemeUtils.isDarkTheme() else 'light'
        if theme == self._theme and not force:
            return
        self._theme = theme
        self.setProperty('theme', theme)
        ThemeUtils.repolishAll(self)
        ThemeUtils.setLinkColor((self.lbl_email, self.lbl_szkolenia), FOOTER_LINK_COLORS[theme])
        self._setFooterLogo()

    def _setFooterLogo(self):
        if self._theme is not None:
            ThemeUtils.setLogo(self.lbl_es_logo, FOOTER_LOGOS[self._theme], FOOTER_LOGO_HEIGHT)

    def showEvent(self, event):
        self._applyTheme()
        super().showEvent(event)
        # Skala ekranu jest znana dopiero po pokazaniu - wcześniej logo byłoby rozpikselowane.
        self._setFooterLogo()
        self._fitHeightOnOpen()

    def _fitHeightOnOpen(self):
        """Przy otwarciu panel dostaje wysokość całej treści, potem minimum jest zwalniane,
        żeby dało się go zmniejszyć (treść jest w obszarze przewijania)."""
        if self._heightFitted or self.isFloating():
            return
        self._heightFitted = True
        frame = 2 * self.style().pixelMetric(QtWidgets.QStyle.PixelMetric.PM_DockWidgetFrameWidth, None, self)
        need = (self.header_frame.sizeHint().height() + self.content_widget.minimumSizeHint().height()
                + self.footer_frame.sizeHint().height() + frame)
        main_window = self.parentWidget()
        if isinstance(main_window, QtWidgets.QMainWindow):
            area = main_window.dockWidgetArea(self)
            others = [d for d in main_window.findChildren(QtWidgets.QDockWidget)
                      if d is not self and d.isVisible() and not d.isFloating()
                      and main_window.dockWidgetArea(d) == area and abs(d.x() - self.x()) < 5]
            room = self.height() + sum(d.height() - d.minimumSizeHint().height() for d in others)
            need = min(need, room)
        if need <= self.height():
            return
        self.setMinimumHeight(need)
        QTimer.singleShot(0, self._releaseMinimumHeight)

    def _releaseMinimumHeight(self):
        try:
            self.setMinimumHeight(0)
        except RuntimeError as e:  # panel usunięty, zanim timer się wykonał
            MessageUtils.pushLogWarning(f"Nie można zwolnić minimalnej wysokości panelu (RuntimeError): {e}")

    def changeEvent(self, event):
        # changeEvent przychodzi już w trakcie setupUi, zanim istnieje _theme.
        if (event.type() in (QEvent.Type.PaletteChange, QEvent.Type.StyleChange)
                and getattr(self, '_theme', None) is not None):
            self._applyTheme()
        super().changeEvent(event)

    def _openHelp(self):
        QDesktopServices.openUrl(QUrl(ThemeUtils.readHomepage() or HOME_LINK))

    def _setupSignals(self):
        self.btn_clear.clicked.connect(self.clearForm)

    def clearForm(self):
        self.cmb_example.setCurrentIndex(-1)
        self.le_example.clear()
        MessageUtils.pushLogInfo(TranslationUtils.tr("Form cleared"))

    def closeEvent(self, event):
        self._heightFitted = False
        self.closingPlugin.emit()
        event.accept()
