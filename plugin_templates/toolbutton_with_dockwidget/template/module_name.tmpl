from .utils import MessageUtils, VersionUtils, TranslationUtils
from qgis.PyQt.QtCore import QSettings, QTranslator, QCoreApplication, Qt, QTimer
from qgis.core import Qgis, QgsSettings
from qgis.PyQt.QtGui import QIcon, QPixmap
from qgis.PyQt.QtWidgets import QAction, QToolBar, QDialog
# Initialize Qt resources from file resources.py
from .resources import *
from . import PLUGIN_NAME, PLUGIN_VERSION
# Import the code for the DockWidget
from .${TemplateModuleName}_dockwidget import ${TemplateClass}DockWidget
import os.path
from .qgis_feed import QgisFeed, QgisFeedDialog


class ${TemplateClass}:
    """QGIS Plugin Implementation."""

    def __init__(self, iface):
        """Konstruktor.
        :param iface: Instancja interfejsu przekazywana do tej klasy,
            która udostępnia mechanizm umożliwiający manipulowanie aplikacją QGIS
            w czasie działania.
        :type iface: QgsInterface
        """
        self.iface = iface

        # inicjalizacja katalogu pluginu
        self.plugin_dir = os.path.dirname(__file__)

        # inicjalizacja tłumaczeń
        locale = QSettings().value('locale/userLocale')[0:2]
        locale_path = os.path.join(
            self.plugin_dir,
            'i18n',
            '${TemplateModuleName}_{}.qm'.format(locale))

        if os.path.exists(locale_path):
            self.translator = QTranslator()
            self.translator.load(locale_path)
            QCoreApplication.installTranslator(self.translator)

        self.settings = QgsSettings()


        # Declare instance attributes
        self.actions = []
        self.menu = u'&EnviroSolutions'
        self.toolbar = None
        self.icon_path = os.path.join(str(self.plugin_dir), 'icons/icon.png')

        self.pluginIsActive = False
        self.dockwidget = None

        # QGIS Feed
        if Qgis.QGIS_VERSION_INT >= 31000:
            QTimer.singleShot(1000, self.initFeedDelayed)


    def add_action(
        self,
        icon_path,
        text,
        callback,
        enabled_flag=True,
        add_to_menu=True,
        add_to_toolbar=True,
        status_tip=None,
        whats_this=None,
        parent=None):
        """        
        :param icon_path: Ścieżka do ikony dla tej akcji. Może to być ścieżka zasobu
            (np. ':/plugins/foo/bar.png') lub zwykła ścieżka systemowa.
        :type icon_path: str

        :param text: Tekst, który powinien być wyświetlany w elementach menu dla tej akcji.
        :type text: str

        :param callback: Funkcja wywoływana po uruchomieniu akcji.
        :type callback: function

        :param enabled_flag: Flaga określająca, czy akcja powinna być domyślnie włączona.
            Domyślnie True.
        :type enabled_flag: bool

        :param add_to_menu: Flaga określająca, czy akcja powinna być również dodana do menu.
            Domyślnie True.
        :type add_to_menu: bool

        :param add_to_toolbar: Flaga określająca, czy akcja powinna być również dodana do paska narzędzi.
            Domyślnie True.
        :type add_to_toolbar: bool

        :param status_tip: Opcjonalny tekst wyświetlany w podpowiedzi (tooltipie), gdy kursor myszy
            znajduje się nad akcją.
        :type status_tip: str

        :param parent: Widget nadrzędny dla nowej akcji. Domyślnie None.
        :type parent: QWidget

        :param whats_this: Opcjonalny tekst wyświetlany na pasku stanu, gdy kursor myszy
            znajduje się nad akcją.

        :returns: Utworzona akcja. Zauważ, że akcja jest również dodawana do listy self.actions.
        :rtype: QAction
        """

        icon = QIcon(icon_path)
        action = QAction(icon, text, parent)
        action.triggered.connect(callback)
        action.setEnabled(enabled_flag)

        if status_tip is not None:
            action.setStatusTip(status_tip)

        if whats_this is not None:
            action.setWhatsThis(whats_this)

        if add_to_toolbar:
            self.toolbar.addAction(action)

        if add_to_menu:
            self.iface.${TemplateMenuAddMethod}(
                self.menu,
                action)

        self.actions.append(action)

        return action


    def initGui(self):
        """Tworzy wpisy w menu i ikony paska narzędzi w interfejsie QGIS."""

        MessageUtils.pushLogInfo(TranslationUtils.tr("Initializing GUI"))
        self.toolbar = self.iface.mainWindow().findChild(QToolBar, 'EnviroSolutions')

        if not self.toolbar:
            self.toolbar = self.iface.addToolBar(u'EnviroSolutions')
            self.toolbar.setObjectName(u'EnviroSolutions')
        else:
            for action in self.actions:
                self.toolbar.removeAction(action)

        self.add_action(
            self.icon_path,
            text=PLUGIN_NAME,
            callback=self.run,
            parent=self.iface.mainWindow())

    #--------------------------------------------------------------------------

    def onClosePlugin(self):
        """Czyszczenie niezbędnych elementów tutaj, gdy dockwidget jest zamknięty"""

        self.dockwidget.hide()
        self.pluginIsActive = False
        MessageUtils.pushLogInfo(TranslationUtils.tr("Plugin closed"))


    def unload(self):
        for action in self.actions:
            self.iface.removePluginMenu(
                u'&EnviroSolutions',
                action
            )
            self.toolbar.removeAction(action)

        

    #--------------------------------------------------------------------------

    def setUpDockwidgetGUI(self):
        """Ustawia interfejs graficzny dockwidgeta"""
        self.dockwidget = ${TemplateClass}DockWidget()
        self.dockwidget.closingPlugin.connect(self.onClosePlugin)
        
        if os.path.exists(self.icon_path):
            self.dockwidget.plugin_icon.setPixmap(QPixmap(self.icon_path))
            self.dockwidget.plugin_icon.setScaledContents(True)

        path_to_logo = os.path.join(self.plugin_dir, 'icons', 'logo.svg')
        if os.path.exists(path_to_logo):
            self.dockwidget.enviro_logo.setPixmap(QPixmap(path_to_logo))
            self.dockwidget.enviro_logo.setScaledContents(True)
        MessageUtils.pushLogInfo(TranslationUtils.tr("Dockwidget is set up"))

    def setDockArea(self):
        if VersionUtils.isCompatibleQtVersion(6):
            self.iface.addDockWidget(Qt.DockWidgetArea.${TemplateDockWidgetArea}, self.dockwidget)
        else:
            self.iface.addDockWidget(Qt.${TemplateDockWidgetArea}, self.dockwidget)

    def run(self):
        """Metoda zawierająca główne funkcjonalności wtyczki"""

        if not self.pluginIsActive:
            self.pluginIsActive = True

            if self.dockwidget == None:
               self.setUpDockwidgetGUI()
            MessageUtils.pushLogInfo(TranslationUtils.tr("Plugin is running"))

            # pokaz dockwidget
            self.setDockArea()
            self.dockwidget.setWindowTitle('%s %s' % (PLUGIN_NAME, PLUGIN_VERSION))
            self.dockwidget.lbl_pluginVersion.setText('%s %s' % (PLUGIN_NAME, PLUGIN_VERSION))
            self.dockwidget.show()
            

#---------------------QGIS Feed------------------------------------
    def showBranchSelectionDialog(self):
        self.qgisfeed_dialog = QgisFeedDialog()

        if self.qgisfeed_dialog.exec() == QDialog.Accepted:
            self.selected_branch = self.qgisfeed_dialog.comboBox.currentText()
            
            #Zapis w QGIS3.ini
            self.settings.setValue("selected_industry", self.selected_branch)  
            self.settings.setValue("showDialog", False)

    def initFeedDelayed(self):
        """Metoda wywoływana z opóźnieniem do inicjalizacji kanalu informacyjnego."""
        try:
            self.selected_industry = self.settings.value("selected_industry", None)
            show_dialog = self.settings.value("showDialog", True, type=bool)

            if self.selected_industry is None and show_dialog:
                # Tylko jeśli mamy dostęp do okna głównego
                if self.iface.mainWindow():
                    self.showBranchSelectionDialog()

            select_indust_session = self.settings.value('selected_industry')
            if select_indust_session:
                self.feed = QgisFeed(selected_industry=select_indust_session, plugin_name=PLUGIN_NAME)
                self.feed.initFeed()
        except Exception as e:
            MessageUtils.pushLogWarning(TranslationUtils.tr("Nie udało się zainicjować kanału informacyjnego: ") + str(e))
